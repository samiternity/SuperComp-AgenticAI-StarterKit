# Copy to .env and fill in. Used only on your laptop; on event day the server sets these.
# Groq has a free tier: create a key at https://console.groq.com/keys
MODEL_URL=https://api.groq.com/openai/v1
MODEL_KEY=gsk_your_key_here
# A tool-calling model with reasoning switched off, so it behaves like the event-day model
# (DeepSeek V4.1 Flash with thinking off). See https://console.groq.com/docs/models
MODEL_NAME=qwen/qwen3.8-27b
MODEL_EXTRA_BODY={"reasoning_effort":"none"}
# Groq's free tier allows 8,000 tokens a minute; retries wait out the limit.
MODEL_MAX_RETRIES=8
